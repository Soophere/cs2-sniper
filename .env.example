# ============================================================
# SECRETS — copy this file to .env and fill in YOUR values.
# Never put real keys in this file. .env is gitignored.
# ============================================================

# Required for scanning (csfloat.com -> Profile -> Developer)
CSFLOAT_API_KEY=your_csfloat_api_key_here

# Discord webhook URL for snipe alerts (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Scanner settings
MIN_PROFIT_USD=2.0
MIN_DISCOUNT_PCT=10.0
MAX_BUY_USD=10.0
POLL_INTERVAL_SEC=60
CSFLOAT_SELLER_FEE_PCT=2.0
SELL_VENUE=csfloat
SKINPORT_SELLER_FEE_PCT=8.0
WAXPEER_SELLER_FEE_PCT=6.0

# Anti-fake-profit guards (loot.farm/skincash/buff are reference prices, not buyable)
BUYABLE_MARKETS=csfloat,skinport,waxpeer,steam
MAX_DISCOUNT_PCT=35.0
PRICE_RISK_BUFFER_PCT=8.0
MIN_SOURCES_AGREE=3
MAX_STICKER_PREMIUM_PCT=12.0
RATE_LIMIT_COOLDOWN_SEC=90
MIN_MARKET_QTY=8
MIN_LIQUIDITY_SCORE=15

# Urgency (hardcoded in server/urgency.py — Discord timing):
# big fish ≥$6 → alert at ≤24h left
# medium ≥$4 → alert at ≤15m left
# small ≥$2 → alert at ≤5m left
# buy_now → alert immediately
# auctions with days left stay in Watching (no Discord spam)

# Server
HOST=127.0.0.1
PORT=8765
