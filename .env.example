# Required for scanning listings under $10 (get from csfloat.com -> Profile -> Developer)
CSFLOAT_API_KEY=

# Discord webhook URL for snipe alerts
DISCORD_WEBHOOK_URL=

# Scanner settings
MIN_PROFIT_USD=2.0
MIN_DISCOUNT_PCT=10.0
MAX_BUY_USD=10.0
POLL_INTERVAL_SEC=60
CSFLOAT_SELLER_FEE_PCT=2.0
RATE_LIMIT_COOLDOWN_SEC=90
MIN_MARKET_QTY=8
MIN_LIQUIDITY_SCORE=15

# Urgency (hardcoded in server/urgency.py — Discord timing):
# big fish ≥$6 → alert at ≤24h left
# medium ≥$4 → alert at ≤15m left
# small ≥$2 → alert at ≤5m left
# buy_now → alert immediately
# auctions with days left stay in Watching (no Discord spam)

# Server
HOST=127.0.0.1
PORT=8765
